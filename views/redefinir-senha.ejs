<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Redefinir Senha - Catálogo de Filmes</title>
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; margin: 40px 20px; background: #141414; color: #fff; }
    .card { max-width: 440px; margin: 40px auto; padding: 30px; background: #222; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
    h2 { margin-top: 0; color: #e50914; text-align: center; }
    label { display: block; margin-top: 12px; font-size: 0.9em; color: #ccc; }
    input { width: 100%; padding: 10px; margin: 6px 0 12px 0; box-sizing: border-box; background: #333; border: 1px solid #444; color: white; border-radius: 4px; }
    input:focus { outline: none; border-color: #e50914; }
    button { width: 100%; padding: 12px; background: #e50914; color: white; border: none; border-radius: 4px; font-size: 1em; font-weight: bold; cursor: pointer; margin-top: 10px; transition: background 0.2s; }
    button:hover { background: #b80710; }
    .erro { background: rgba(255, 77, 77, 0.15); border: 1px solid #ff4d4d; color: #ff8080; padding: 12px; border-radius: 4px; font-size: 0.9em; margin-bottom: 15px; line-height: 1.4; }
    .info { background: rgba(0, 123, 255, 0.15); border: 1px solid #007bff; color: #70b4ff; padding: 10px; border-radius: 4px; font-size: 0.85em; margin-bottom: 15px; }
    .links { margin-top: 20px; text-align: center; font-size: 0.9em; color: #aaa; }
    .links a { color: #007bff; text-decoration: none; }
    .links a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Redefinir Senha</h2>

    <% if (locals.erro) { %>
      <div class="erro">⚠️ <%= erro %></div>
    <% } %>

    <% if (locals.valid) { %>
      <div class="info">
        👤 Redefinindo senha da conta: <strong><%= locals.email || '' %></strong><br>
        ⏰ Este link é válido por 30 minutos e só pode ser utilizado uma vez.
      </div>

      <form action="/redefinir-senha" method="POST">
        <input type="hidden" name="token" value="<%= token %>">

        <label>Nova Senha:</label>
        <input type="password" name="novaSenha" placeholder="Digite a nova senha" required minlength="4">

        <label>Confirmar Nova Senha:</label>
        <input type="password" name="confirmarSenha" placeholder="Confirme a nova senha" required minlength="4">

        <button type="submit">Salvar Nova Senha</button>
      </form>
    <% } else { %>
      <div class="links" style="margin-top: 25px;">
        <p><a href="/esqueci-senha">👉 Solicitar um novo link de recuperação</a></p>
        <p style="margin-top: 15px;"><a href="/login">Voltar ao Login</a></p>
      </div>
    <% } %>
  </div>
</body>
</html>

