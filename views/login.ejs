<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Catálogo de Filmes</title>
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; margin: 40px 20px; background: #141414; color: #fff; }
    .card { max-width: 420px; margin: 40px auto; padding: 30px; background: #222; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
    h2 { margin-top: 0; color: #e50914; text-align: center; }
    label { display: block; margin-top: 12px; font-size: 0.9em; color: #ccc; }
    input { width: 100%; padding: 10px; margin: 6px 0 12px 0; box-sizing: border-box; background: #333; border: 1px solid #444; color: white; border-radius: 4px; }
    input:focus { outline: none; border-color: #e50914; }
    button { width: 100%; padding: 12px; background: #e50914; color: white; border: none; border-radius: 4px; font-size: 1em; font-weight: bold; cursor: pointer; margin-top: 10px; transition: background 0.2s; }
    button:hover { background: #b80710; }
    .erro { background: rgba(255, 77, 77, 0.15); border: 1px solid #ff4d4d; color: #ff8080; padding: 10px; border-radius: 4px; font-size: 0.9em; margin-bottom: 15px; }
    .sucesso { background: rgba(70, 211, 105, 0.15); border: 1px solid #46d369; color: #46d369; padding: 10px; border-radius: 4px; font-size: 0.9em; margin-bottom: 15px; }
    .links { margin-top: 20px; text-align: center; font-size: 0.9em; color: #aaa; }
    .links a { color: #007bff; text-decoration: none; }
    .links a:hover { text-decoration: underline; }
    .forgot-link { display: block; margin-top: 8px; font-size: 0.85em; color: #bbb; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Entrar no Catálogo</h2>
    
    <% if (locals.erro) { %>
      <div class="erro">⚠️ <%= erro %></div>
    <% } %>
    <% if (locals.sucesso) { %>
      <div class="sucesso">✅ <%= sucesso %></div>
    <% } %>

    <form action="/login" method="POST">
      <label>E-mail:</label>
      <input type="email" name="email" placeholder="exemplo@email.com" required>

      <label>Senha:</label>
      <input type="password" name="senha" placeholder="Sua senha" required>

      <button type="submit">Entrar</button>
    </form>

    <div class="links">
      <a href="/esqueci-senha" class="forgot-link">Esqueci minha senha</a>
      <p style="margin-top: 15px;">Não tem uma conta? <a href="/cadastro">Cadastre-se</a></p>
    </div>
  </div>
</body>
</html>